[
  {
    "name": "decision_observe",
    "description": "Passively capture an already-active selected window and issue a fresh single-use capture_id. Never activates a background window. Use native capture for explicit initial activation. Invalidates prior decisions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "decision_evaluate",
    "description": "Bind a bounded choice to the current capture and immutable caller-supplied actions. One candidate is a deterministic caller action; multiple candidates in local mode return observe. Default auto (with fallback) or explicit gemini mode sends selected window pixels to Google Gemini Decision 1 when an API key is configured. No input is sent. Returns a single-use decision_id only for a sufficiently confident choice. Rechecks pixels before and after evaluation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "capture_id": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "action": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "click"
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "type",
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "scroll"
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "clicks": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100,
                        "not": {
                          "const": 0
                        }
                      },
                      "horizontal": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "x",
                      "y",
                      "clicks"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "type_text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "type",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "hotkey"
                      },
                      "keys": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        }
                      }
                    },
                    "required": [
                      "type",
                      "keys"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "description",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1,
          "default": 0.85
        }
      },
      "required": [
        "target",
        "capture_id",
        "goal",
        "candidates"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "decision_act",
    "description": "Consume one stored decision_id, recheck full observation, execute exactly its one stored action, then adaptively wait and return a fresh image/capture_id. Execution never accepts replacement action arguments. No automatic retries. outcome=settled indicates pixel stability, not task success; timeout/error after input must not be blindly repeated.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "wait": {
          "type": "object",
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1500
            },
            "stable_ms": {
              "type": "integer",
              "minimum": 25,
              "maximum": 1000,
              "default": 100
            },
            "poll_ms": {
              "type": "integer",
              "minimum": 5,
              "maximum": 100,
              "default": 25
            },
            "allow_hover": {
              "type": "boolean",
              "default": true
            },
            "allow_caret_drift": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "decision_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
